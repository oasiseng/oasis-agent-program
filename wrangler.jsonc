{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oasis-agent-program",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "PROGRAM_ENABLED": "false",
    "WORLD_RPC_URL": "https://worldchain-mainnet.g.alchemy.com/public",
    "DAILY_HUMAN_LIMIT": "5",
    "IP_MINUTE_LIMIT": "20"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "oasis-agent-pilot", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
  "triggers": { "crons": ["17 3 * * *"] }
}
